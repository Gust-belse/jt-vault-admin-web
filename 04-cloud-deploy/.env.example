# ============================================================================
# 04-cloud-deploy/.env.example
# Sao chép thành .env khi chạy script/worker cục bộ (KHÔNG commit file .env!)
# ============================================================================

# --- CÔNG KHAI (An toàn dùng trên Frontend / GitHub Pages) ---
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...YOUR_PUBLIC_ANON_KEY

# --- BÍ MẬT MÁY CHỦ (CHỈ DÙNG CHO PYTHON SYNC WORKER / EDGE FUNCTIONS) ---
# TUYỆT ĐỐI KHÔNG BAO GIỜ ĐƯA SERVICE_ROLE_KEY VÀO FRONTEND HOẶC GIT!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# --- GEMINI API KEY (Lưu riêng tại Supabase Edge Function Secrets) ---
# supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=your-gemini-api-key
